# Copy to .env (never commit the filled-in file) or export these variables directly.

# --- Test environment (tests/ and the test-environment examples) ---
# API key for the shared PIXXIO demo system. Ask a maintainer for access.
PIXXIO_TEST_API_KEY=
# Optional, defaults to hoerl-demo.px.media
PIXXIO_TEST_HOST=

# --- Production/tenant access (examples and your own code) ---
# API key for the PIXXIO server you are targeting.
PIXXIO_API_KEY=
# Host of that server, for example company.pixxio.com
PIXXIO_HOST=

# --- Webhook stub (webhook_stub/) ---
# Shared secret used to verify PIXXIO webhook HMAC-SHA256 signatures.
PIXXIO_WEBHOOK_SECRET=

# --- Optional tuning ---
# Directory the webhook stub writes received events to.
WEBHOOK_STORAGE_DIR=

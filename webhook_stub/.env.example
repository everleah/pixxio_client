# Copy to .env (never commit the filled-in file) and `docker compose up -d`.
# Docker Compose reads this file automatically for variable interpolation.

# Shared secret used to verify PIXXIO webhook HMAC-SHA256 signatures (required).
PIXXIO_WEBHOOK_SECRET=

# Public hostname the stub is served under, e.g. webhook-stub.example.com (required).
STUB_HOST=

# External Traefik network the stub joins, e.g. traefik-net (required).
STUB_NETWORK=
